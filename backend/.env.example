# Sao chép thành backend/.env rồi chỉnh. KHÔNG commit .env (chứa mật khẩu).
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cờ tính năng P2 (trống = chỉ MVP). Một nguồn sự thật cho backend và React (GET /api/auth/me).
# workflow,highlight,handwriting,extraction,classification,versions,borrowing,notifications,imports,rollback
FEATURES_ENABLED=

# Dữ liệu
DATABASE_URL=postgresql+psycopg://dms:CHANGE_ME@localhost:5432/dms
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=             # trống = dùng REDIS_URL
STORAGE_ROOT=./storage         # private storage, ngoài mọi thư mục static

# Session / bảo mật (SDD mục 14). Production bắt buộc SESSION_BACKEND=redis.
SESSION_BACKEND=redis          # redis | memory (memory chỉ cho dev một tiến trình)
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=dms_sid
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Giới hạn upload (NFR-01, D-01: chốt sau khi đo trên máy triển khai)
MAX_UPLOAD_MB=25
MAX_PAGES=100
# FR-16 (v0.13): số file tối đa gộp thành một tài liệu khi tải lên
MAX_MERGE_FILES=20
# FR-15 (v0.13): tài liệu đi kèm - số file mỗi bộ, MB mỗi file, tổng MB mỗi bộ
MAX_ATTACHMENTS=20
MAX_ATTACHMENT_MB=25
MAX_BUNDLE_MB=200
MAX_IMAGE_PIXELS=60000000

# Xóa mềm / khôi phục (D-05)
SOFT_DELETE_RETENTION_DAYS=30
# FR-14 (v0.13): giá trị mặc định ban đầu; Admin đổi trên giao diện Quản trị → Cấu hình (audit tối thiểu 180)
AUDIT_RETENTION_DAYS=365
PURGE_INTERVAL_SECONDS=86400

# Job nền (FR-04, NFR-03)
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=30
JOB_STALE_SECONDS=1800
JOB_REQUEUE_AFTER_SECONDS=600
REQUEUE_INTERVAL_SECONDS=300

# OCR (NFR-08, D-06). Chữ in (GUIDE 9): auto = VietOCR nếu đã cài requirements-hw.txt (đọc đúng dấu tiếng Việt),
# không thì PaddleOCR | vietocr | paddleocr
OCR_ENGINE=auto
OCR_VIETOCR_CONFIG=vgg_seq2seq   # vgg_seq2seq (~8 s/trang CPU) | vgg_transformer (chính xác hơn ~1 điểm, ~25 s/trang)
OCR_VIETOCR_MAX_RATIO=12         # chia dòng dài tại khoảng trắng giữa từ (VietOCR cụt đuôi dòng A4 nếu không chia)
OCR_LANG=vi
OCR_DEVICE=cpu
# Model PaddleOCR: dò dòng (dùng cho cả vietocr) và nhận dạng (chỉ khi OCR_ENGINE=paddleocr). Để trống cả hai =
# PP-OCRv6 medium (~50 s/trang).
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=latin_PP-OCRv5_mobile_rec
OCR_RENDER_DPI=200               # đo: 300 không tốt hơn với bản scan ~200 DPI (GUIDE 9)
OCR_UPSCALE_MIN_WIDTH=1600       # ảnh trang hẹp hơn (px) được phóng to tối đa 2 lần; 0 = tắt
OCR_PRELOAD_ON_START=true
OCR_MODEL_SOURCE_CHECK=false
OCR_PREPROCESS_DENOISE=false
TEXT_LAYER_MIN_CHARS=20
# FR-04 (v0.9): trang PDF có lớp chữ vẫn OCR ảnh nhúng >= tỷ lệ diện tích trang này (chưa có chữ bên trong)
OCR_IMAGE_MIN_AREA=0.02
OCR_IMAGE_MAX_REGIONS=8
NEEDS_REVIEW_THRESHOLD=85      # hiệu chỉnh bằng eval/calibrate_threshold.py trên tập dev

# P2-03 chữ viết tay (hàng đợi ocr_hw; worker chính nghe cả ocr_hw, WORKER_OCR_PROFILES=print,handwriting)
OCR_HW_ENGINE=auto             # auto (vietocr nếu đã cài, không thì paddleocr-hw) | vietocr | paddleocr-hw
OCR_HW_REC_MODEL=
VIETOCR_CONFIG=vgg_transformer
OCR_HW_DET_MODEL=                # trống = dùng chung model dò dòng của chữ in (OCR_DET_MODEL)
VIETOCR_CACHE_DIR=               # trống = ~/.cache/vietocr (cấu hình + weights tải một lần)

# P2-05 phân loại (scikit-learn TF-IDF + Logistic Regression): xác suất tối thiểu của gợi ý cao nhất
CLASSIFY_MIN_SCORE=0.3
CLASSIFY_MAX_TRAINING_DOCS=300

# P2-07 mượn hồ sơ: chu kỳ nhắc quá hạn
BORROW_REMIND_INTERVAL_SECONDS=86400

# P2-08 bulk import (NFR-01: chặn zip bomb, đường dẫn vượt thư mục)
IMPORT_MAX_FILES=200
IMPORT_MAX_TOTAL_MB=500
IMPORT_MAX_ZIP_RATIO=100

# Chỉ dùng cho scripts/seed_demo.py
DEMO_ADMIN_PASSWORD=

# FR-18 (v0.13): chia sẻ ra ngoài bằng link + OTP email. Để trống SMTP_HOST = tắt tính năng.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<địa chỉ gmail>, SMTP_PASSWORD=<app password 16 ký tự>
# Thử local không gửi thật: chạy Mailpit (docker compose --profile tools up -d mailpit), SMTP_HOST=127.0.0.1,
# SMTP_PORT=1025, SMTP_STARTTLS=false, xem thư ở http://127.0.0.1:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PUBLIC_BASE_URL=http://127.0.0.1:8080
EXTERNAL_SHARE_MAX_HOURS=24
