# Mẫu .env cho Docker Compose (đặt ở thư mục gốc, cạnh compose.yaml). KHÔNG commit .env.
# scripts\docker_start.ps1 tự tạo .env từ file này với mật khẩu ngẫu nhiên nếu chưa có.
# Các biến khác của backend (giới hạn upload, OCR, job...) xem backend/.env.example - thêm vào đây nếu cần đổi.

APP_ENV=production
POSTGRES_USER=dms
POSTGRES_DB=dms
POSTGRES_PASSWORD=__RANDOM__

# Cờ P2 (trống = chỉ MVP)
FEATURES_ENABLED=workflow,highlight,handwriting,extraction,classification,versions,borrowing,notifications,imports,rollback

# Địa chỉ người dùng mở trình duyệt (kiểm tra Origin chống CSRF). Thêm https://ten-mien khi lên server.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WEB_PORT=8080
# 127.0.0.1 = chỉ máy này truy cập. Trên server (sau reverse proxy HTTPS) hoặc mở cho mạng LAN: 0.0.0.0
WEB_BIND=127.0.0.1

# Cookie Secure: mặc định bật khi production (cần HTTPS; trình duyệt chấp nhận ngoại lệ localhost/127.0.0.1).
# Chỉ đặt false khi thử nghiệm qua http bằng IP mạng LAN.
# SESSION_COOKIE_SECURE=false

# Mật khẩu admin ban đầu (scripts/seed_demo.py). Đổi ngay sau lần đăng nhập đầu.
DEMO_ADMIN_PASSWORD=__RANDOM__
